<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >

  <!-- ZCML includes are idempotent, so repeating this is what a real site
       package would do; it cannot assume load order. Include the package
       itself, never just its meta.zcml, or the override silently does
       nothing. -->
  <include package="z3c.jbot" />

  <browser:jbot
      directory="overrides"
      layer=".interfaces.ISiteLayer"
      />

</configure>
