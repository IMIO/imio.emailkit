<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:emailkit="http://namespaces.imio.be/emailkit"
    i18n_domain="dummy.minimal"
    >

  <include package="imio.emailkit" file="meta.zcml" />

  <!-- No `directory`: it defaults to `templates`, relative to this package. -->
  <emailkit:templates>

    <!-- The subject msgid's domain is this file's `i18n_domain`. No
         `preheader`: optional, and the kit collapses it when absent. -->
    <emailkit:template
        name="notification"
        subject="[email_subject_notification] A notification from your commune"
        />

  </emailkit:templates>

</configure>
