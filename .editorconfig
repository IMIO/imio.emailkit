
# EditorConfig file. See https://editorconfig.org.
root = true


[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space

[*.{py,cfg,ini}]
indent_size = 4

[*.{html,dtml,pt,zpt,xml,zcml,js,json,ts,less,scss,css,sass,yml,yaml,vue}]
indent_size = 2

# These files are Maizzle build output, compared byte for byte by the
# staleness check. Do not let an editor reformat them.
[src/imio/emailkit/templates/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

[src/imio/emailkit/browser/overrides/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

# Golden snapshots are compared byte for byte.
[tests/golden/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

[{Makefile,.gitmodules}]
# Tab indentation. View at 4 spaces.
indent_style = tab
indent_size = unset
tab_width = unset
