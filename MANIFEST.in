graft src/imio
graft news
graft tests
include *.md
include *.toml
include LICENSE.GPL

# The design system ships inside this egg. `bin/compile-emails` resolves
# `src/imio/emailkit/kit/` from the installed distribution, so the `.vue`,
# `.js` and `.css` sources under `graft src/imio` are shipped files.
# `pyproject.toml`'s `[tool.setuptools.package-data]` lists the same
# extensions for the wheel; this line covers the sdist.

# The Maizzle project is dev-only. Node must not appear in an installed
# distribution.
prune emails

# `recipe/` is the other distribution in this repository
# (`imio.recipe.emailkit`) and must never travel inside this one's sdist.
prune recipe

global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
