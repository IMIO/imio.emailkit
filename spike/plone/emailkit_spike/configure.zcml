<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >

  <!-- CMFPlone does NOT include z3c.jbot; in a real instance z3c.autoinclude
       (entry point `[z3c.autoinclude.plugin] target = plone`) pulls it in, but
       autoinclude is disabled in PLONE_FIXTURE.

       NOTE: including only `file="meta.zcml"` is NOT enough. meta.zcml merely
       registers the browser:jbot directive; the ViewPageTemplateFile.__get__
       monkeypatches that make overrides effective live in
       z3c.jbot/configure.zcml (`<include package="z3c.jbot.patches" />`).
       With meta.zcml alone the directive parses, the TemplateManager is built
       with the correct path mapping, and the override silently does nothing. -->
  <include package="z3c.jbot" />

  <browser:jbot
      directory="overrides"
      layer=".interfaces.IEmailkitSpikeLayer"
      />

</configure>
