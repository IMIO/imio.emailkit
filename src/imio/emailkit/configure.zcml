<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:emailkit="http://namespaces.imio.be/emailkit"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="imio.emailkit"
    >

  <include file="meta.zcml" />

  <i18n:registerTranslations directory="locales" />

  <include file="dependencies.zcml" />
  <include file="profiles.zcml" />
  <include file="adapters.zcml" />

  <include package=".browser" />

  <!-- The vocabulary loads first: the content-rule action schema names it. -->
  <include package=".vocabularies" />
  <include package=".contentrules" />

  <!-- imio.emailkit registers its own templates through the same directive
       external add-ons use. `get_username` and the two mails below it use
       views this package owns (`browser/login_help.py`,
       `browser/default_mails.py`). -->
  <emailkit:templates directory="templates">
    <emailkit:template
        name="notification"
        preheader="[email_preheader_notification] You have a new notification."
        subject="[email_subject_notification] Notification"
        />
    <emailkit:template
        name="get_username"
        preheader="[email_preheader_get_username] Here is the username you asked for."
        subject="[email_subject_get_username] Your username"
        />
    <emailkit:template
        name="mail_password_template"
        preheader="[email_preheader_mail_password_template] Follow the link to choose a new password."
        subject="[email_subject_mail_password_template] Password reset request"
        />
    <emailkit:template
        name="registered_notify_template"
        preheader="[email_preheader_registered_notify_template] Follow the link to choose your password."
        subject="[email_subject_registered_notify_template] An account has been created for you"
        />
    <emailkit:template
        name="user_migrated_to_sso"
        preheader="[email_preheader_sso_migrated] Log in from now on with Wallonie Connect, using your email address."
        subject="[email_subject_sso_migrated] Your account now uses Wallonie Connect"
        />
  </emailkit:templates>

  <!-- -*- extra stuff goes here -*- -->

</configure>
