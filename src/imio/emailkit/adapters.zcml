<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="imio.emailkit"
    >

  <!-- Default recipient adapters, for a `str` and for a Plone member.
       Add a new recipient kind as one more adapter line. -->

  <!-- No `for=`/`provides=` attributes. The @adapter and @implementer
       decorators on the factories supply them. -->
  <adapter factory=".recipients.recipient_from_string" />
  <adapter factory=".recipients.recipient_from_member" />

</configure>
