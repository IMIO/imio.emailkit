<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="imio.emailkit"
    >

  <!-- Raster assets the kit shell and `KitPill` load by absolute URL. A mail
       client fetches images over HTTP after the message left the egg, so
       each asset needs a stable, anonymous URL under the portal.

       On IDefaultBrowserLayer, not IEmailkitLayer, because a `:base` site
       renders its own templates through the kit shell too.

       PNG, not SVG: mail clients do not display SVG reliably. -->
  <browser:resourceDirectory
      name="imio.emailkit"
      directory="static"
      />

  <!-- z3c.jbot, so a site can override the `.pt` files this package
       resolves. The WHOLE package, not `file="meta.zcml"`: the
       `ViewPageTemplateFile.__get__` monkeypatches live in
       `z3c.jbot/configure.zcml`, and without them an override is silently
       ignored.

       CMFPlone does not include z3c.jbot itself, and PLONE_FIXTURE disables
       autoinclude, so the include has to be here. -->
  <include package="z3c.jbot" />

  <!-- The two remaining Plone default mails, as owned views. Same `name`,
       `for` and `permission` as the stock registrations, differing only by
       layer. No `template=`: each class renders a registered template
       through `render()` and returns the RFC822 document `RegistrationTool`
       expects.

       On IEmailkitLayer, which only `:default` installs: a `:base` site
       keeps stock Plone's views and mails. -->
  <browser:page
      name="mail_password_template"
      for="*"
      class=".default_mails.MailPasswordView"
      permission="zope.Public"
      layer="imio.emailkit.interfaces.IEmailkitLayer"
      />

  <browser:page
      name="registered_notify_template"
      for="*"
      class=".default_mails.RegisteredNotifyView"
      permission="zope.Public"
      layer="imio.emailkit.interfaces.IEmailkitLayer"
      />

  <!-- The third restyled default mail: the username reminder from the
       login-help form. Stock Plone has no template for it, so there is no
       file for jbot to key on and the view is the only seam.

       Same `name`, `for` and `permission` as the stock registration,
       differing only by layer. No `template=`: the class supplies `index`
       itself, pointing at Plone's own login_help.pt, so the form markup
       stays jbot-overridable. On IEmailkitLayer, like the two views above. -->
  <browser:page
      name="login-help"
      for="plone.base.interfaces.INavigationRoot"
      class=".login_help.LoginHelpForm"
      permission="zope.Public"
      layer="imio.emailkit.interfaces.IEmailkitLayer"
      />

  <!-- Fallback theme tokens for a consumer template rendered by a stock
       view: `theme` is not in scope there. On IDefaultBrowserLayer, so a
       `:base` consumer has the same escape. -->
  <browser:page
      name="emailkit_theme"
      for="*"
      class=".theme.EmailkitThemeView"
      permission="zope2.View"
      />

  <!-- The preview: the page, and the rendered mail on its own for the
       page's iframe, split so the mail's stylesheet cannot restyle the
       Plone UI. `cmf.ManagePortal`, not `zope2.View`: this renders arbitrary
       templates against fixture data and can put mail on the wire. On
       IEmailkitLayer, so a `:base` site has no preview. -->

  <!-- `cmf.ManagePortal` must be a registered permission utility before the
       two `browser:page` actions below run. cookiecutter-zope-instance
       includes this package before `Products.CMFCore`'s permissions.zcml,
       so without this include the registrations fail at start-up. -->
  <include
      package="Products.CMFCore"
      file="permissions.zcml"
      />

  <browser:page
      name="emailkit-preview"
      for="*"
      class=".preview.EmailkitPreview"
      permission="cmf.ManagePortal"
      layer="imio.emailkit.interfaces.IEmailkitLayer"
      />

  <browser:page
      name="emailkit-preview-body"
      for="*"
      class=".preview.EmailkitPreviewBody"
      permission="cmf.ManagePortal"
      layer="imio.emailkit.interfaces.IEmailkitLayer"
      />

</configure>
