<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="imio.emailkit"
    >

  <!-- The registered template names, as a vocabulary from discovery.
       Registered as a named utility, so a schema can name it as a string
       instead of importing discovery.

       Registered globally, unlike the content-rule action it feeds (that one
       is per site, set up by the `:default` profile). A `:base` site without
       that action still needs the vocabulary to resolve, or its forms raise
       VocabularyRegistryError instead of showing an empty list. -->
  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="imio.emailkit.templates"
      component=".templates"
      />

</configure>
