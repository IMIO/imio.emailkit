<?xml version="1.0" encoding="utf-8"?>
<!-- Removing the layer restores Plone's stock mails, which is the whole of what
     `:default` added. The `imio.emailkit.theme.*` records go too; see
     registry.xml next to this file for why that overrides the usual instinct of
     never destroying settings on uninstall. -->
<layers>
  <layer name="imio.emailkit"
         remove="true"
  />
</layers>
