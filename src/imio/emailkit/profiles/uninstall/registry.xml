<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="imio.emailkit"
>

  <!-- Remove SPEC §3's three theme tokens along with the add-on.

       This deliberately overrides the usual Plone instinct of never destroying
       settings on uninstall. These records are defined by an interface that
       ships in this egg, and `plone.app.registry` resolves that interface when
       it reads them: once the egg is gone, `IEmailkitTheme` is no longer
       importable and the registry control panel raises on the orphaned records.
       A broken control panel is a hard, site-wide failure; the three values
       lost are branding for mails that no longer exist.

       Reinstalling re-creates the records from the interface defaults, so the
       only real cost is re-entering a logo URL and a colour. -->
  <records interface="imio.emailkit.interfaces.IEmailkitTheme"
           prefix="imio.emailkit.theme"
           remove="true"
  />

</registry>
