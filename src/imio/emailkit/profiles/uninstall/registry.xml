<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="imio.emailkit"
>

  <!-- Remove the three theme tokens along with the add-on.

       `plone.app.registry` resolves `IEmailkitTheme` to read these records.
       Once the egg is gone, the interface is no longer importable, and the
       registry control panel raises on the orphaned records. Reinstalling
       re-creates the records from the interface defaults. -->
  <records interface="imio.emailkit.interfaces.IEmailkitTheme"
           prefix="imio.emailkit.theme"
           remove="true"
  />

</registry>
