<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="imio.emailkit"
>

  <!-- The three theme tokens, as `imio.emailkit.theme.<token>`.

       No <value> elements. `plone.app.registry` seeds each record from its
       field default in `interfaces.IEmailkitTheme`, so the default lives in
       one place only.

       Only `primary_color` has a non-empty default. `logo_url` is
       site-specific. `footer_html` is user-facing wording, and wording does
       not belong in a profile: it would freeze one language for every site. -->
  <records interface="imio.emailkit.interfaces.IEmailkitTheme"
           prefix="imio.emailkit.theme"
  />

</registry>
