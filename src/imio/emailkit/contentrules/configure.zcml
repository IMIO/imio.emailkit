<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="imio.emailkit"
    >

  <!-- `plone.app.contentrules` declares the `ManageContentRules` permission
       and ships no `permissions.zcml`, so the whole package must be
       included. The permission must be registered before the
       `browser:page` actions below run, or they fail at start-up with a
       `ComponentLookupError`.

       `plone.contentrules`' `meta.zcml` defines the `plone:ruleAction`
       directive used at the bottom of this file. -->
  <include package="plone.app.contentrules" />
  <include
      package="plone.contentrules"
      file="meta.zcml"
      />

  <!-- The executor delegates to Email(...). -->
  <adapter factory=".mail.StyledMailActionExecutor" />

  <browser:page
      name="imio.emailkit.actions.StyledMail"
      for="plone.app.contentrules.browser.interfaces.IRuleActionAdding"
      class=".mail.StyledMailAddFormView"
      permission="plone.app.contentrules.ManageContentRules"
      />

  <browser:page
      name="edit"
      for=".mail.IStyledMailAction"
      class=".mail.StyledMailEditFormView"
      permission="plone.app.contentrules.ManageContentRules"
      />

  <!-- The action type, registered like every other `plone.contentrules`
       action. Not conditional on the `:default` profile: an action type is
       inert until a Manager creates a rule that uses it.

       `event="*"` and `for="*"`: a styled mail is worth sending on any
       trigger, and the action reads only what any content object has.

       `title` and `description` are plain strings, not msgids: the
       directive's fields are `schema.TextLine`/`schema.Text`, with no way to
       hand them a message object, like Plone's own "Send email" action.
       Everything the action shows inside its own forms goes through `_()`
       and ships FR/NL/DE. -->
  <plone:ruleAction
      name="imio.emailkit.actions.StyledMail"
      title="Send styled email"
      description="Send a styled email built from a registered template, through the imio.emailkit builder: one message per recipient language, with the subject translated accordingly."
      for="*"
      event="*"
      schema=".mail.IStyledMailAction"
      factory=".mail.StyledMailAction"
      addview="imio.emailkit.actions.StyledMail"
      editview="edit"
      />

</configure>
