<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="imio.emailkit"
    >

  <!-- `:base` ships the runtime (render(), discovery, the theme records) but
       not the browser layer, so Plone's stock mails stay untouched. It stays
       visible in the add-ons control panel: installing it instead of
       `:default` is how a site opts out. -->
  <genericsetup:registerProfile
      name="base"
      title="iMio Emailkit: runtime only"
      description="Email templating runtime without the restyled Plone default mails. Install this instead of the default profile to keep Plone's stock mails untouched."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/base"
      />

  <genericsetup:registerProfile
      name="default"
      title="iMio Emailkit: Install"
      description="Email templating runtime plus the restyled Plone default mails."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="iMio Emailkit: Uninstall"
      description="Uninstall iMio Emailkit setup."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="imio.emailkit"
      />

  <include package=".upgrades" />

</configure>
