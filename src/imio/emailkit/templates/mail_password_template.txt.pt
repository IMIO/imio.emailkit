<tal:body
  ><tal:admin tal:condition="not:is_anonymous"><span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_mail_password_admin_request">The site administrator has asked you to reset the password of the account <span i18n:name="userid" tal:omit-tag="" tal:content="userid">userid</span>. Your previous password no longer works.</span>

</tal:admin><span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_mail_password_lead">Use the button below to choose a new password for <span i18n:name="site_name" tal:omit-tag="" tal:content="site_name">the site</span>.</span>

<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_mail_password_cta">Choose a new password</span> : <span tal:omit-tag="" tal:content="reset_url" />

<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_mail_password_expiry">This link is valid for <span i18n:name="hours" tal:omit-tag="" tal:content="expiration_hours">24</span> hours.</span>
<tal:anonymous tal:condition="is_anonymous">
<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_mail_password_tracking">If you did not ask for this, simply ignore this message: your password has not been changed. The request came from the IP address <span i18n:name="ipaddress" tal:omit-tag="" tal:content="client_addr">0.0.0.0</span>.</span>
</tal:anonymous>
--
<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_footer_default">This message was sent automatically. Please do not reply to it.</span>
</tal:body>
