<!DOCTYPE html>
<html
  lang="${lang}"
  dir="ltr"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
  i18n:domain="imio.emailkit"
  tal:define="lang lang | options/lang | request/LANGUAGE | string:en; preheader preheader | options/preheader | nothing; title title | options/title | nothing; subtitle subtitle | options/subtitle | nothing; body_html body_html | options/body_html | nothing; theme theme | options/theme | context/@@emailkit_theme | nothing; logo_url python:(theme or {}).get('logo_url') or ''; primary_color python:(theme or {}).get('primary_color') or '#e6007e'; footer_html python:(theme or {}).get('footer_html') or ''; portal_url portal_url | options/portal_url | string:; asset_base python:(str(portal_url).rstrip('/') + '/++resource++imio.emailkit') if portal_url else ''"
>
  <head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title tal:condition="title">${title}</title>
    <!--[if mso]> <style> td,th,div,p,a,h1,h2,h3,h4,h5,h6 {font-family: Arial, Helvetica, sans-serif; mso-line-height-rule: exactly;} </style> <![endif]-->
    <link tal:condition="asset_base" rel="stylesheet" href="${asset_base}/fonts.css">
    <style>
      @media (max-width: 600px) {
        .sm-w-full {
          width: 100% !important;
        }
        .sm-px-5 {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .sm-text-2xl {
          font-size: 24px !important;
          line-height: 32px !important;
        }
        .sm-leading-8 {
          line-height: 32px !important;
        }
      }
      @media (prefers-color-scheme: dark) {
        [data-dark="page"] {
          background-color: #121212 !important;
        }
        [data-dark="surface"] {
          background-color: #1c1c1c !important;
        }
        [data-dark="raised"] {
          background-color: #242424 !important;
        }
        [data-dark="body"] {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] td {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] th {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] div {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] p {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] h1 {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] h2 {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] h3 {
          color: #d2d2d2 !important;
        }
        [data-dark="body"] li {
          color: #d2d2d2 !important;
        }
        [data-dark="muted"] {
          color: #a8a8a8 !important;
        }
        [data-dark="muted"] td {
          color: #a8a8a8 !important;
        }
        [data-dark="muted"] p {
          color: #a8a8a8 !important;
        }
        [data-dark="body"] [data-dark="accent"] {
          color: #ffadd9 !important;
        }
        [data-dark="accent"] {
          color: #ffadd9 !important;
        }
      }
    </style>
  </head>
  <body xml:lang="${lang}" dir="ltr" data-dark="page" style="margin: 0; width: 100%; background-color: #ededed; padding: 0; word-break: break-word;">
    <div tal:condition="preheader" style="display:none;font-size:1px;color:#ededed;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
      ${preheader}&#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847;
      &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847; &#8199;&#65279;&#847;
    </div>
    <span style="display:none;">
      <!--[if mso]> <xml> <o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings> <w:WordDocument><w:DontUseAdvancedTypographyReadingMail /></w:WordDocument> </xml> <![endif]-->
    </span>
    <div role="article" aria-roledescription="email" lang="${lang}" dir="ltr" class="font-body" data-dark="page" style="background-color: #ededed; font-family: Nunito, 'Avenir LT Std', Arial, Helvetica, sans-serif; font-size: 14px; line-height: 20px; color: #1c1c1c;">
      <table role="presentation" data-dark="page" style="width: 100%; background-color: #ededed;" cellpadding="0" cellspacing="0">
        <tr>
          <td align="center" style="padding: 32px 12px 36px;">
            <table role="presentation" align="center" width="600" class="sm-w-full" data-dark="surface" style="width: 600px; max-width: 100%; border-radius: 12px; background-color: #fff; text-align: left;" cellpadding="0" cellspacing="0">
              <tr>
                <td height="120" tal:attributes="background python:(asset_base + '/art-head.png') if asset_base else None" style="height: 120px; border-top-left-radius: 12px; border-top-right-radius: 12px; background-size: 400px 120px; background-position: 100% 0; background-repeat: no-repeat; padding: 0;">
                  <table role="presentation" style="width: 100%;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td class="sm-px-5" style="padding: 24px 40px;">
                        <table role="presentation" style="width: 100%;" cellpadding="0" cellspacing="0">
                          <tr>
                            <td align="left" style="font-size: 0; line-height: 0;">
                              <img tal:condition="logo_url" src="${logo_url}" alt="iMio" i18n:attributes="alt email_logo_alt" width="158" style="display: block;">
                              <img tal:condition="python:not logo_url and asset_base" src="${asset_base}/imio-logo.png" alt="iMio" i18n:attributes="alt email_logo_alt" width="108" height="32" style="display: block;">
                            </td>
                            <td align="right">
                              <table role="presentation" align="right" cellpadding="0" cellspacing="0">
                                <tr>
                                  <td bgcolor="#ffffff" style="border-radius: 400px; background-color: #fff; padding: 6px 14px 6px 11px;">
                                    <table role="presentation" cellpadding="0" cellspacing="0">
                                      <tr>
                                        <td tal:condition="asset_base" style="padding-right: 7px; font-size: 0; line-height: 0;"><img src="${asset_base}/pill-info.png" alt width="14" height="14" style="display: block;"></td>
                                        <td style="font-family: Quicksand, 'Trebuchet MS', Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: 700; white-space: nowrap; color: #1c1c1c;"><span i18n:translate="email_pill_your_account" tal:omit-tag>Your account</span></td>
                                      </tr>
                                    </table>
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td
                  bgcolor="#f8f8f8"
                  tal:attributes="background python:(asset_base + '/art-head-tail.png') if asset_base else None"
                  class="sm-px-5"
                  data-dark="raised"
                  style="background-color: #f8f8f8; background-size: 400px 80px; background-position: 100% 0; background-repeat: no-repeat; padding: 22px 40px 30px; border-bottom: 1px solid #d2d2d2;"
                >
                  <table role="presentation" data-dark="body" style="width: 100%;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td>
                        <h1 class="sm-text-2xl sm-leading-8" style="margin: 0; font-family: Quicksand, 'Trebuchet MS', Arial, Helvetica, sans-serif; font-size: 28px; line-height: 36px; font-weight: 700; color: #1c1c1c;"><span i18n:translate="email_get_username_title" tal:omit-tag>Your username</span></h1>
                        <p style="margin: 0; padding-top: 10px; font-size: 14px; line-height: 22px; color: #3c3c3b;">${site_name}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td class="sm-px-5" data-dark="body" style="padding: 30px 40px 24px; font-size: 15px; line-height: 24px; color: #1c1c1c;">
                  <p i18n:translate="email_get_username_greeting" style="margin: 0 0 16px; font-size: 15px; line-height: 24px; color: #1c1c1c;">
                    Dear
                    <span i18n:name="fullname" tal:omit-tag tal:content="fullname">Name</span>,
                  </p>
                  <p i18n:translate="email_get_username_lead" style="margin: 0; font-size: 15px; line-height: 24px; color: #3c3c3b;">
                    You asked to be reminded of your username for
                    <span i18n:name="site_name" tal:omit-tag tal:content="site_name">the site</span>.
                  </p>
                  <table role="presentation" style="margin-top: 20px; width: 100%; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border: 2px solid #ededed;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td width="6" bgcolor="${primary_color}" style="width: 6px; font-size: 0; line-height: 0;">&nbsp;</td>
                      <td style="padding: 0;">
                        <table role="presentation" data-dark="raised" style="width: 100%; border-top-right-radius: 10px; border-bottom-right-radius: 10px; background-color: #f8f8f8;" cellpadding="0" cellspacing="0">
                          <tr>
                            <td style="padding: 20px 22px;">
                              <p data-dark="accent" style="margin: 0 0 8px; font-family: Quicksand, 'Trebuchet MS', Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 1.2px; color: #b3004b; text-transform: uppercase;">
                                <span i18n:translate="email_field_username" tal:omit-tag>Username</span>
                              </p>
                              <p style="margin: 0; font-family: Quicksand, 'Trebuchet MS', Arial, Helvetica, sans-serif; font-size: 18px; line-height: 25px; font-weight: 700; color: #1c1c1c;">${login}</p>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                  <table role="presentation" align="center" style="margin-top: 20px;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td bgcolor="${primary_color}" style="border-radius: 12px; text-align: center; mso-padding-alt: 13px 26px;">
                        <a href="${login_url}" style="display: block; border-radius: 12px; padding: 13px 26px; font-size: 16px; line-height: 1.25; font-weight: 700; color: #fff; text-decoration: none;"><span i18n:translate="email_get_username_cta" tal:omit-tag>Log in</span></a>
                      </td>
                    </tr>
                  </table>
                  <table role="presentation" style="margin-top: 20px; width: 100%; border-radius: 12px; border: 2px solid #ffadd9;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td style="padding: 16px 20px;">
                        <p data-dark="accent" style="margin: 0 0 4px; font-family: Quicksand, 'Trebuchet MS', Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 1.2px; color: #b3004b; text-transform: uppercase;">
                          <span i18n:translate="email_callout_not_you" tal:omit-tag>Not you?</span>
                        </p>
                        <p i18n:translate="email_get_username_tracking" style="margin: 0; font-size: 14px; line-height: 22px; color: #1c1c1c;">
                          If you did not ask for this, simply ignore this message. The request came from the IP address
                          <span i18n:name="ipaddress" tal:omit-tag tal:content="client_addr">0.0.0.0</span>.
                        </p>
                      </td>
                    </tr>
                  </table>
                  <div tal:condition="body_html" tal:content="structure body_html" style="font-size: 15px; line-height: 24px;"></div>
                </td>
              </tr>
              <tr tal:condition="asset_base">
                <td style="padding: 0; font-size: 0; line-height: 0;"><img src="${asset_base}/art-hero.png" alt width="600" style="margin-top: -32px; display: block; width: 100%; max-width: 600px;"></td>
              </tr>
              <tr>
                <td bgcolor="#1c1c1c" class="sm-px-5" style="border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; background-color: #1c1c1c; padding: 26px 40px 28px;">
                  <table role="presentation" style="width: 100%;" cellpadding="0" cellspacing="0">
                    <tr>
                      <td align="center" style="text-align: center; font-size: 12px; line-height: 20px; color: #ededed;">
                        <div tal:condition="footer_html" tal:content="structure footer_html"></div>
                        <p tal:condition="not:footer_html" i18n:translate="email_footer_default" style="margin: 0; font-size: 12px; line-height: 20px; color: #ededed;">This message was sent automatically. Please do not reply to it.</p>
                      </td>
                    </tr>
                    <tr tal:condition="asset_base">
                      <td align="center" style="padding-top: 18px; font-size: 0; line-height: 0;"><img src="${asset_base}/imio-logo-negative.png" alt="iMio" i18n:attributes="alt email_logo_alt" width="68" height="20" style="margin-left: auto; margin-right: auto; display: block;"></td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
