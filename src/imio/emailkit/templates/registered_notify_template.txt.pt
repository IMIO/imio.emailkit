<tal:body
  ><span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_registered_notify_greeting">Hello <span i18n:name="fullname" tal:omit-tag="" tal:content="fullname">Fullname</span>,</span>

<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_registered_notify_created">Your account has been created. Choose a password to start using it.</span>

<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_field_username">Username</span> : <span tal:omit-tag="" tal:content="username" />
<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_field_fullname">Full name</span> : <span tal:omit-tag="" tal:content="fullname" />
<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_field_email">Email address</span> : <span tal:omit-tag="" tal:content="email" />

<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_registered_notify_cta">Choose my password</span> : <span tal:omit-tag="" tal:content="password_url" />

<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_registered_notify_expiry">This link is valid until <span i18n:name="expiration_date" tal:omit-tag="" tal:content="python: format_datetime(expires)">date</span>.</span>

--
<span tal:omit-tag="" i18n:domain="imio.emailkit" i18n:translate="email_footer_default">This message was sent automatically. Please do not reply to it.</span>
</tal:body>
