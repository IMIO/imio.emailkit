<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:emailkit="http://namespaces.imio.be/emailkit"
    i18n_domain="emailkitdemo"
    >

  <include package="imio.emailkit" file="meta.zcml" />

  <!-- The one template this throwaway addon ships (SPEC §4's in-package
       layout: `emails/` and `templates/` as siblings inside the package). -->
  <emailkit:templates directory="templates">
    <emailkit:template
        name="demo"
        subject="[email_subject_demo] Demo notification"
        preheader="[email_preheader_demo] A throwaway preheader for the acceptance test."
        />
  </emailkit:templates>

</configure>
